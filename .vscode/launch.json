    "version": "0.2.0",
    "configurations": [
        {
            "name": "marksapi-no-args",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": [],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-version",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": ["--version"],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-help",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": ["--help"],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-aggregate-bar",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": [
                "massive", 
                "aggregate-bar", 
                "stocks", 
                "AAPL,MSFT", 
                "--from", "2026-06-30", 
                "--to", "2026-06-30"],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-aggregate-bar-csv",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": [
                "massive", 
                "aggregate-bar", 
                "stocks", 
                "AAPL", 
                "--from", "2026-06-20", 
                "--to", "2026-06-30",
                "--format", "csv"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-aggregate-bar-tickers-csv",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": [
                "massive", 
                "aggregate-bar", 
                "stocks", 
                "--tickers", "AAPL,MSFT",
                "--from", "2026-06-20", 
                "--to", "2026-06-30",
                "--format", "csv"],
            "stopAtEntry": false,
            "console": "internalConsole"
        },           
        {
            "name": "marksapi-aggregate-bar-tickers-json",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": [
                "massive", "aggregate-bar", 
                "stocks", 
                "--tickers", "AAPL,MSFT",
                "--from", "2026-06-20", 
                "--to", "2026-06-30", 
                "--format", "json"
            ],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-short-volume",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "short-volume", "AAPL"],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-short-volume-json",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": [
                "massive", "short-volume", 
                "AAPL",
                "--from", "2026-06-30",
                "--to", "2026-06-30", 
                "--format", "json"
            ],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-ticker-info",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "ticker-info"],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-ticker-info-json",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "ticker-info", "stocks", "AAPL", "--format", "json"],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-tickers",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "tickers"],
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-tickers-json",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "tickers", "stocks", "--ticker", "AAPL", "--format", "json"],
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ]
}