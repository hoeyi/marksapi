    "version": "0.2.0",
    "configurations": [
        {
            "name": "marksapi-agg-bars",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/marksapi/bin/Debug/net10.0/marksapi.dll",
            "args": ["--version"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-aggregate-bar",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/marksapi/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "aggregate-bar"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-short-volume",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/marksapi/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "short-volume", "AAPL"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-ticker-info",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/marksapi/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "ticker-info"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "marksapi-tickers",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/marksapi/bin/Debug/net10.0/marksapi.dll",
            "args": ["massive", "tickers"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ]
}