{
  "Serilog": {
    "Using":  [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", 
        "Args": 
        { 
            "path": "/app/data/logs/.txt",
            "rollingInterval": "Day"
        } 
        },
      { "Name": "File", 
        "Args": 
        { 
            "path": "/app/data/logs/.json",
            "rollingInterval": "Day",
            "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        } 
      }
    ],
    "Properties": {
        "Application": "marksapi"
    }
  },
  "massive": {
        "RateOptions":{
            "Limit": 5,
            "Interval": 60
        },
        "QueryOptions": {
          "UpperLimit": 5000,
          "LowerLimit": 1
        }
      },
  "output_path": "/app/data"
}