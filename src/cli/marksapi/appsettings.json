{
  "Serilog": {
    "Using":  [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", 
        "Args": 
        { 
            "path": "logs/.txt",
            "rollingInterval": "Day"
        } 
        },
      { "Name": "File", 
        "Args": 
        { 
            "path": "logs/.json",
            "rollingInterval": "Day",
            "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        } 
      }
    ],
    "Properties": {
        "Application": "marksapi"
    }
  },
  "massive": {
        "RateOptions":{
            "Limit": 5,
            "Interval": 60
        },
        "Query": {
          "Upper_Limit": 5000,
          "Lower_Limit": 1
        }
  }
}