{
  "Serilog": {
    "Using":  [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", 
            "Args": 
            { 
                "path": "logs/.txt"
            } 
        },
      { "Name": "FileJson", 
            "Args": 
            { 
                "path": "logs/.json",
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter"
            } 
        }
    ],
    "Properties": {
        "Application": "ApiClient.test"
    }
  }
}