<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <!-- Regexes matched against each source file's full path; [\\/] covers Windows and Unix separators -->
            <Sources>
              <Exclude>
                <Source>.*[\\/]obj[\\/].*</Source>
              </Exclude>
            </Sources>
            <!-- Also catches source generator output, which usually isn't physically in obj -->
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>